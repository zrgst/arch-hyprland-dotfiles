{
	"layer": "top",
	"modules-left": ["hyprland/workspaces", "mpd", "sway/mode"],
	"modules-center": ["custom/launcher"],
	"modules-right": ["network", "pulseaudio", "temperature", "cpu", "memory", "clock"],
	"mpd": {
		"tooltip": false,
		"format": "{stateIcon} {artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
		"format-disconnected": "ﳌ",
		"format-stopped": "",
        "state-icons": {
            "playing": "",
            "paused": ""
        }
	},
  "custom/launcher": {
      "format": "  ",
      "tooltip": false,
      "on-click": "walker-zrgst-menu"
  },
  "hyprland/workspaces": {
      "all-outputs": false,
      "format": "{name}",
      "disable-scroll": false
  },
	"pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "{icon} {volume}%",
		"format-icons": {
			"default": ["  ", "  ", "  "]
		}
	},
	"network": {
		"tooltip": false,
		"format-wifi": "  {essid} {ipaddr}",
		"format-ethernet": "  {ipaddr}"
	},
	"cpu": {
		"tooltip": false,
		"format": "󰻠  {}%"
	},
	"memory": {
		"tooltip": false,
		"format": "󰍛  {}%"
	}
}
